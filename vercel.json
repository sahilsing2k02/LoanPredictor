{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "front_end/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/predict", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/front_end/$1" }
  ]
}
